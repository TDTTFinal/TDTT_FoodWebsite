# ====================================
# EVALUATION TESTS CONFIGURATION
# ====================================
# Copy this file to .env and fill in your values

# ====================================
# Backend Configuration
# ====================================
BASE_URL=http://localhost:5000
SEARCH_PATH=/api/search/advanced

# ====================================
# External APIs
# ====================================
# HuggingFace Food Tour API
HF_BASE_URL=https://nemo-chewz.hf.space/api/v1/search/

# OSRM Routing API (public demo server)
OSRM_BASE_URL=https://router.project-osrm.org

# ====================================
# Database Configuration
# ====================================
MONGO_URI=mongodb://localhost:27017/tdtt_food

# ====================================
# Default Test Parameters
# ====================================
# Default location (Ho Chi Minh City center)
DEFAULT_LAT=10.7769
DEFAULT_LON=106.7009

# Search parameters
DEFAULT_RADIUS=5
DEFAULT_ALPHA=0.6
DEFAULT_TOP_K=5

# ====================================
# Performance Test Settings
# ====================================
# k6 Virtual Users
K6_MAX_VUS=5

# Request timeouts (milliseconds)
REQUEST_TIMEOUT=10000
